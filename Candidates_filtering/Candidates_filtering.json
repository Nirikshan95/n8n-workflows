    {
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate the resume for the role of {{ $('On form submission').item.json.Role }}.\n\nReturn JSON only:\n{\n  \"score\": number (0–10),\n  \"highlights\": string\n}\n\nScoring rules:\n- Judge from  skills, experience, projects, tools, and certifications etc relevant to the role.\n- Penalize missing core skills, irrelevant experience, or low hands-on work.\n\nHighlight rule:\n- If score > 8.5, provide a 1–2 sentence highlight of the strongest strengths.\n- Otherwise return an empty string in \"highlights\".\n- Example :\n\"{\n\t\"score\": 7,\n\t\"highlights\": \"\"\n}\".\n\nhere the resume : \"{{ $json.text }}\"\n",
        "hasOutputParser": true,
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "message": "Evaluate the resume for Java Developer.  Return: {   \"score\": number (0–10),   \"highlights\": string }  Score strictly based on Java-related experience, projects, frameworks, backend exposure, databases, and cloud/DevOps skills.  If score > 8.5, add a brief highlight; else keep highlights empty."
            }
          ]
        },
        "batching": {
          "batchSize": 5
        }
      },
